# Copy to .env.local and fill in. Never commit .env.local.

# Neon: pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL=
# Neon: direct connection string, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Generate with: npx auth secret
AUTH_SECRET=
# Only needed for `npm run start` outside Vercel.
# AUTH_TRUST_HOST=true

# Public address of the app, for link previews. On Vercel it defaults to the
# production domain; set it for a custom domain.
# SITE_URL=

# GitHub OAuth app. Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client. Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Encrypts the AI keys users save in Pengaturan (AES-256-GCM). Optional: without
# it the app runs, but nobody can save a key. Generate with: openssl rand -base64 32
# Changing it makes every saved key unreadable; users then save theirs again.
AI_KEY_ENCRYPTION_KEY=
