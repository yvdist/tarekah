# Copy to .env.local and fill in. Never commit .env.local.

# Neon: pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL=
# Neon: direct connection string, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Generate with: npx auth secret
AUTH_SECRET=
# Only needed for `npm run start` outside Vercel.
# AUTH_TRUST_HOST=true

# GitHub OAuth app. Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client. Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
